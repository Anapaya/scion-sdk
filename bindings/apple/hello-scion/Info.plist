<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright 2026 Anapaya Systems

  The test network's control API is plain HTTP on the Mac, deliberately neither SCION nor TLS, and
  App Transport Security refuses a cleartext request without an exception. The SCION request itself
  is HTTP/3 over QUIC on the library's own sockets and unaffected.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Hello SCION</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
