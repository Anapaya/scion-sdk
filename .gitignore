bindings/apple/scion-http3-swift/.swiftpm/
bindings/apple/scion-http3-swift/*.xcframework/

# Android bindings (Gradle output, and the native libraries and bindings that
# non-Gradle steps write into generated/)
bindings/android/.gradle/
bindings/android/.kotlin/
bindings/android/build/
bindings/android/*/build/
bindings/android/*/generated/
bindings/android/local.properties
