# Apple bindings (the static libraries and the generated bindings, written into
# generated/; SwiftPM output; and the generated Swift and the XCFramework that
# apple.py writes into the package)
bindings/apple/generated/
bindings/apple/scion-http3-swift/Sources/ScionHTTP3Uniffi/
